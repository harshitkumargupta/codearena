POSTGRES_DB=codearena
POSTGRES_USER=codearena
POSTGRES_PASSWORD=codearena
POSTGRES_PORT=5433

REDIS_PORT=6379

RABBITMQ_USER=codearena
RABBITMQ_PASSWORD=codearena
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
JWT_ACCESS_TOKEN_TTL=2h
CORS_ALLOWED_ORIGINS=http://localhost:5173

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@codearena.local
ADMIN_PASSWORD=change-me-admin

# AI tutor: provider is chosen only by AI_CHAT_PROVIDER (ollama | openai)
AI_CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
# For a hosted OpenAI-compatible endpoint set AI_CHAT_PROVIDER=openai and:
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_READ_TIMEOUT=60s
AI_MAX_TOKENS=400
TUTOR_LEVEL3_COOLDOWN=5m
TUTOR_DAILY_CAP=30
