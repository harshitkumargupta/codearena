# Copy to .env and change every "change-me" value. docker compose refuses to start while a required value is missing.

# --- Required ---------------------------------------------------------------------------------------------------
POSTGRES_PASSWORD=change-me-postgres
RABBITMQ_PASSWORD=change-me-rabbitmq
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@codearena.local
ADMIN_PASSWORD=change-me-admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# Group id that owns the Docker socket as the daemon sees it; the worker joins this group to use the socket.
#   Colima:       colima ssh -- stat -c %g /var/run/docker.sock
#   Linux host:   stat -c %g /var/run/docker.sock
#   Any daemon:   docker run --rm -v /var/run/docker.sock:/s alpine stat -c %g /s
DOCKER_SOCKET_GID=

# --- Optional ---------------------------------------------------------------------------------------------------
POSTGRES_DB=codearena
POSTGRES_USER=codearena
RABBITMQ_USER=codearena

# Published ports. The frontend is published on all interfaces; Prometheus and Grafana only on 127.0.0.1.
FRONTEND_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# The browser origin of the frontend; must match FRONTEND_PORT. For `npm run dev` use http://localhost:5173.
CORS_ALLOWED_ORIGINS=http://localhost:8080
JWT_ACCESS_TOKEN_TTL=2h

# Judge images the worker runs (build them with: docker compose --profile judge-images build)
JUDGE_JAVA_IMAGE=codearena/judge-java:latest
JUDGE_PYTHON_IMAGE=codearena/judge-python:latest

# AI tutor: provider is chosen only by AI_CHAT_PROVIDER (ollama | openai). If the provider cannot be reached the
# tutor endpoints answer 503 and everything else keeps working.
AI_CHAT_PROVIDER=ollama
# Inside Compose, host.docker.internal is the machine running Docker (Ollama started on the host).
# For an api run on the host, use http://localhost:11434.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
# For a hosted OpenAI-compatible endpoint set AI_CHAT_PROVIDER=openai and:
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_READ_TIMEOUT=60s
AI_MAX_TOKENS=400
TUTOR_LEVEL3_COOLDOWN=5m
TUTOR_DAILY_CAP=30

# Rate limits (Bucket4j in Redis; a Redis outage answers 503 on limited endpoints)
RATE_LIMIT_SUBMISSIONS_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=30
RATE_LIMIT_LOGIN_PER_USERNAME_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
RATE_LIMIT_TUTOR_PER_MINUTE=5
# Host-run api only: comma-separated proxy addresses whose X-Forwarded-For is trusted. In Compose the api trusts
# only the frontend container (fixed address 172.29.80.200).
RATE_LIMIT_TRUSTED_PROXIES=

# Request size limits (bytes), host-run api only
HTTP_MAX_BODY_BYTES=262144
HTTP_MAX_TEST_CASE_BODY_BYTES=33554432
PROBLEM_MAX_TEST_DATA_BYTES=67108864

# Host-run development (docker-compose.dev.yml publishes these on 127.0.0.1)
POSTGRES_PORT=5433
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
