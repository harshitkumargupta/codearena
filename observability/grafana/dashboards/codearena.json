          "expr": "histogram_quantile(0.5, sum by (le) (rate(codearena_submission_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p50",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(codearena_submission_e2e_latency_seconds_bucket[1m])))",
          "legendFormat": "p95",
          "refId": "B",
          "range": true,
          "instant": false
