# Base URL of the CodeArena api. Default: http://localhost:8080 (cross-origin; the api must allow this app's origin
# in CORS_ALLOWED_ORIGINS, default http://localhost:5173).
# Set to "/" to call the api through the Vite dev proxy instead (same origin; needed to read Retry-After on 429).
VITE_API_URL=http://localhost:8080
# Optional: STOMP WebSocket URL. Default: derived from VITE_API_URL (ws://localhost:8080/ws).
# VITE_WS_URL=ws://localhost:8080/ws
